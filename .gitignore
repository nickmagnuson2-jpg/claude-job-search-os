tools/.therapy-classifier.txt
tools/.personal-projects.txt
tools/.personal-vault.conf
tools/.granola-pending-classification.json

# LinkedIn-scanner cache (scraped profiles, parsed JSON, pickled session cookie, login screenshots — never commit)
tools/linkedin-scanner/src/cache/

# Local-only Claude settings (permissions/env; not for the public repo)
.claude/settings.local.json

# Calibration ledger (personal outcome data)
data/calibration/

# Session scratch space. Working copies only; anything durable belongs in
# output/ (gitignored + covered by tools/backup-data.sh) or in the repo proper.
# Untracked AND un-ignored meant a 48KB spec was one `git add -A` from the public
# repo, against its own header. 2026-08-12.
scratchpad/

# Local-only expectations for --validate-local (Tier 2) on outreach_status /
# transcript_exclusions / check_prep_doc / check_doc_precedence. Holds real names,
# real output paths and verbatim quotes; the committed tests use placeholders only.
tools/.local-validators.json

# Analysis-method frame state files. Hold verbatim problem statements, quotes from
# private recruiting calls, named-person hypotheses and live engagement analysis.
# The schema documents `output/<slug>/frame.yaml`, which inherits this protection
# because /output/ is already ignored; a dedicated top-level tree does NOT, so it is
# ignored explicitly here. Added 2026-08-16 on the first live run, before any commit.
frames/

# pytest-cov artifact
.coverage
