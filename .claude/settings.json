            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_replace_all_safety.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_edit_safety.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_plan_partner_critique.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_script_error_logged.py"
