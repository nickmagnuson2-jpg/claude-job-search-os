    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/log_tool_failure.py"
