          },
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_no_confabulation.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_data_projects.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_public_pii.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
