            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_draft_voice.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_todo_write_kwargs.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_bare_python.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_screenshot_path.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/check_living_log_purity.py"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
