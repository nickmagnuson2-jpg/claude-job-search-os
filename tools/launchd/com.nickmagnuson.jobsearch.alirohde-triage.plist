<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nickmagnuson.jobsearch.alirohde-triage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/opt/homebrew/bin/python3 /Users/mag/Documents/Obsidian/30-projects/job-search/tools/alirohde_nudge.py --repo-root /Users/mag/Documents/Obsidian/30-projects/job-search</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONIOENCODING</key>
        <string>utf-8</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <!-- /tmp, not the repo: this job runs via `bash -c`, and bash calls
         getcwd() at startup. launchd agents lack TCC access to ~/Documents,
         so a repo cwd logged "getcwd: cannot access parent directories:
         Operation not permitted" on every run. Every path in
         ProgramArguments is absolute, so cwd is not otherwise used. -->
    <key>WorkingDirectory</key>
    <string>/tmp</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mag/Documents/Obsidian/30-projects/job-search/tools/launchd/logs/alirohde-triage.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mag/Documents/Obsidian/30-projects/job-search/tools/launchd/logs/alirohde-triage.err</string>
</dict>
</plist>
